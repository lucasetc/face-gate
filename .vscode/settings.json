{
  // Python: usa o ambiente local .venv (criado a partir do requirements-dev.txt)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  // Cada Lambda importa seus módulos pelo nome (ex.: "import regras"), como na AWS
  "python.analysis.extraPaths": ["lambdas/api", "lambdas/event_processor", "face-service"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests/unit"],

  // Scripts shell rodam no Linux do contêiner: sempre com quebra de linha LF
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    ".pytest_cache": true,
    ".ruff_cache": true
  }
}
